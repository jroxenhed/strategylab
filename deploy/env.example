# Two secret files live on the VM under /etc/strategylab/ (root:strategylab, 0640).
# Source of truth is the bastion01 secrets store; never commit real values.

# ---------------------------------------------------------------------------
# /etc/strategylab/backend.env  — loaded by strategylab-backend.service
# (same keys as backend/.env on the Mac)
# ---------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
POLYGON_API_KEY=
SLACK_WEBHOOK_URL=
NOTIFY_URL=
BOT_POLL_MS=100
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
# ACTIVE_BROKER=alpaca      # global default broker for the trading page; bots carry their own

# ---------------------------------------------------------------------------
# /etc/strategylab/ibc.env  — read once by deploy/install.sh to render /opt/ibc/config.ini
# ---------------------------------------------------------------------------
IB_USER=
IB_PASSWORD=
IB_TRADING_MODE=paper
