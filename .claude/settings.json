{
  "permissions": {
    "allow": [
      "Bash(git checkout *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/hooks/dispatch-tier-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_FILE_PATH\" in */frontend/src/*.ts|*/frontend/src/*.tsx) cd /Users/jroxenhed/Documents/strategylab/frontend && npx tsc -b 2>&1 | head -5 ;; esac",
            "timeout": 15000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/hooks/subagent-usage.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
