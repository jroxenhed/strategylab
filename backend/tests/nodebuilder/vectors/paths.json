   "relative_to": null,
   "expect": "n_deep",
   "why": "same name as /rsi, other parent"
  },
  {
   "graph": "tree",
   "path": "/rsi_ab12",
   "relative_to": null,
   "expect": "/rsi_ab12",
   "why": "an old path-like id is found by its name"
  },
  {
   "graph": "tree",
   "path": "/regime/nope",
   "relative_to": null,
   "expect": null,
   "why": "missing child"
  },
