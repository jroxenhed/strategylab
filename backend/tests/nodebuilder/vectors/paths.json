  {
   "graph": "tree",
   "path": "/rsi",
   "relative_to": "n_spy",
   "expect": "n_rsi",
   "why": "absolute ignores relative_to"
  },
  {
   "graph": "tree",
   "path": "../..",
   "relative_to": "n_spy",
   "expect": null,
   "why": "ends at the root"
  },
  {
   "graph": "tree",
   "path": "../../..",
   "relative_to": "n_spy",
   "expect": null,
   "why": "above the root"
  },
  {
   "graph": "tree",
   "path": "../x",
