 "rename_node": [
  {
   "graph": "tree",
   "id": "n_rsi",
   "new_name": "rsi_fast",
   "expect": {
    "paths": {
     "n_ticker": "/aapl",
     "n_rsi": "/rsi_fast",
     "n_regime": "/regime",
     "n_spy": "/regime/spy",
     "n_sma": "/regime/sma",
     "n_inner": "/regime/inner",
     "n_deep": "/regime/inner/rsi",
     "/rsi_ab12": "/rsi_ab12"
    }
   },
   "why": "plain rename"
  },
  {
   "graph": "tree",
   "id": "n_inner",
   "new_name": "core",
   "expect": {
    "paths": {
     "n_ticker": "/aapl",
     "n_rsi": "/rsi",
     "n_regime": "/regime",
     "n_spy": "/regime/spy",
     "n_sma": "/regime/sma",
     "n_inner": "/regime/core",
     "n_deep": "/regime/core/rsi",
     "/rsi_ab12": "/rsi_ab12"
    }
   },
   "why": "renaming a network moves its children's paths"
  },
  {
   "graph": "tree",
   "id": "n_deep",
   "new_name": "sma",
   "expect": {
    "paths": {
     "n_ticker": "/aapl",
     "n_rsi": "/rsi",
     "n_regime": "/regime",
     "n_spy": "/regime/spy",
     "n_sma": "/regime/sma",
     "n_inner": "/regime/inner",
     "n_deep": "/regime/inner/sma",
     "/rsi_ab12": "/rsi_ab12"
    }
   },
   "why": "sma is taken only under /regime, not under /regime/inner"
  },
  {
   "graph": "tree",
   "id": "n_rsi",
   "new_name": "rsi",
   "expect": {
    "paths": {
     "n_ticker": "/aapl",
     "n_rsi": "/rsi",
     "n_regime": "/regime",
     "n_spy": "/regime/spy",
     "n_sma": "/regime/sma",
     "n_inner": "/regime/inner",
     "n_deep": "/regime/inner/rsi",
     "/rsi_ab12": "/rsi_ab12"
    }
   },
   "why": "same name is a no-op"
  },
  {
   "graph": "tree",
   "id": "n_spy",
   "new_name": "sma",
   "expect": {
    "error": "name_duplicate"
   },
   "why": "sibling already called sma"
  },
  {
   "graph": "tree",
   "id": "n_rsi",
   "new_name": "regime",
   "expect": {
    "error": "name_duplicate"
   },
   "why": "root already has regime"
  },
  {
   "graph": "tree",
   "id": "n_rsi",
   "new_name": "Bad",
   "expect": {
    "error": "name_invalid"
   },
   "why": "upper case"
  },
  {
   "graph": "tree",
   "id": "n_rsi",
   "new_name": "",
   "expect": {
    "error": "name_invalid"
   },
   "why": "empty"
  },
  {
   "graph": "tree",
   "id": "n_rsi",
   "new_name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
   "expect": {
    "error": "name_invalid"
   },
   "why": "too long"
  },
  {
   "graph": "tree",
   "id": "n_missing",
   "new_name": "x",
   "expect": {
    "error": "node_not_found"
   },
   "why": "unknown id"
  }
 ]
