   "expect": "n_rsi",
   "why": "up two levels"
  },
  {
   "graph": "tree",
   "path": "..",
   "relative_to": "n_spy",
   "expect": "n_regime",
   "why": "the enclosing network"
  },
  {
   "graph": "tree",
   "path": ".",
   "relative_to": "n_spy",
   "expect": "n_spy",
   "why": "the node itself"
  },
  {
   "graph": "tree",
   "path": "spy",
   "relative_to": "n_regime",
   "expect": "n_spy",
   "why": "a bare name goes into a child"
  },
  {
   "graph": "tree",
   "path": "./spy",
   "relative_to": "n_regime",
   "expect": "n_spy",
   "why": "dot then child"
  },
  {
   "graph": "tree",
   "path": "inner/rsi",
   "relative_to": "n_regime",
   "expect": "n_deep",
   "why": "two levels down"
  },
  {
   "graph": "tree",
   "path": "../inner/rsi",
   "relative_to": "n_sma",
   "expect": "n_deep",
   "why": "sibling network's child"
