   "why": "dot-dot goes up"
  },
  {
   "graph": "tree",
   "path": "/..",
   "relative_to": null,
   "expect": null,
   "why": "above the root finds nothing"
  },
  {
   "graph": "tree",
   "path": "/RSI",
   "relative_to": null,
   "expect": null,
   "why": "names are case-sensitive"
  },
  {
   "graph": "tree",
   "path": "rsi",
   "relative_to": null,
   "expect": "n_rsi",
   "why": "relative with no base starts at the root"
  },
  {
   "graph": "tree",
   "path": "../sma",
   "relative_to": "n_spy",
   "expect": "n_sma",
   "why": "sibling"
  },
  {
