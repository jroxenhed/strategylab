   "path": "",
   "relative_to": null,
   "expect": null,
   "why": "empty path"
  },
  {
   "graph": "tree",
   "path": "//rsi",
   "relative_to": null,
   "expect": "n_rsi",
   "why": "empty segments are skipped"
  },
  {
